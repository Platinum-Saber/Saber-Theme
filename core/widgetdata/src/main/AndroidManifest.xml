<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather: Open-Meteo over coarse location. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar widget: upcoming instances. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Media widget: thumbnails of videos played in VLC, whose own artwork provider
         only serves the system. Asked from the widget artwork, never at startup. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Media widget resume (MediaResumer): find apps' browser services and media-button receivers. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application>
        <!-- Lets MediaSessionManager.getActiveSessions accept us; also reads WhatsApp notifications
             (only) for the mascot's message cloud. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
