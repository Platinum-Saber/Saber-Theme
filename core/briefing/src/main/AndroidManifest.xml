<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Briefing: missed calls Saber mentions. Asked from Settings → Briefing, never at startup. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application>
        <!-- Mail labeller: LiteRT-LM's GPU backend needs the vendor OpenCL libraries;
             optional so the app still installs where they are missing (rules label then). -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!-- Briefing runs (BriefingWorker) execute here, in their own process, so the
             2 GB model never lives in Home's process. Only WorkManager binds it. -->
        <service
            android:name="androidx.work.multiprocess.RemoteWorkerService"
            android:exported="false"
            android:process=":brain" />
    </application>

</manifest>
